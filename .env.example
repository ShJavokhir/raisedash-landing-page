# Environment Variables Example
# Copy this file to .env.local and fill in the actual values

# JWT Secret for unsubscribe functionality
UNSUBSCRIBE_JWT_SECRET="your-jwt-secret-here"

# Telegram Bot Configuration (for demo request notifications)
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# OPTIONAL: route /get-a-demo, /demo, and /start-v2 submissions to a separate chat. Falls back
# to TELEGRAM_CHAT_ID when unset, so you can split these leads out later with no
# code change.
TELEGRAM_LEADS_CHAT_ID=

# WorkOS Configuration (for magic link invitations)
WORKOS_API_KEY=sk_your-workos-api-key
# WORKOS_REDIRECT_URI=https://app.raisedash.com/auth/callback

# Cloudflare R2 (blog image uploads)
# Used by: ./tools/upload-blog-image.sh
CF_API_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id

# Cloudflare Turnstile (CAPTCHA)
# Get keys from: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# IndexNow (instant search engine crawl notifications)
# Used by: POST /api/indexnow (Authorization: Bearer <secret>)
INDEXNOW_SECRET=your-indexnow-secret

# Raisedash backend (NestJS) public base URL. The /start onboarding funnel posts
# leads DIRECTLY to ${NEXT_PUBLIC_API_URL}/v1/public/onboarding so the backend
# sees the real client IP via CF-Connecting-IP —
# a Vercel proxy hop would mask it. Defaults to https://api.raisedash.com.
# NOTE: the backend must allow this site's origin via CORS_ALLOWED_ORIGINS
# (https://www.raisedash.com,https://raisedash.com).
NEXT_PUBLIC_API_URL=https://api.raisedash.com

# ── Meta FLEET pixel (site-wide; the only dataset this site's ads optimize on) ──
# Events: Contact (= engaged visit) → Lead → Schedule, each a browser Pixel + server
# CAPI pair deduped on a shared event id. Everything no-ops until set.
NEXT_PUBLIC_META_FLEET_PIXEL_ID=
# System-user access token from Events Manager → Settings → Conversions API.
# SECRET, server-only. Without it only the browser half of each event is sent.
META_FLEET_CAPI_ACCESS_TOKEN=
# Optional server-side override of the pixel id (defaults to the public one).
META_FLEET_PIXEL_ID=
# Events Manager → Test Events code. TESTING ONLY — leave blank in production.
META_FLEET_CAPI_TEST_EVENT_CODE=
# Graph API version for the CAPI endpoint. Defaults to v25.0 if unset.
META_GRAPH_API_VERSION=v25.0

# Legacy driver-training pixel — now used ONLY by /start-v3 (the Academy buy-now
# funnel), browser-only. /start and /start-v2 dropped it 2026-10-01.
NEXT_PUBLIC_META_PIXEL_ID=

# PostHog — no env needed: the publishable project token lives in
# src/lib/posthog-config.ts (see CLAUDE.md "PostHog analytics").
